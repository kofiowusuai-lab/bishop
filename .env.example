# Values are read at process start. Bishop does not automatically load this file.
# Select an installed, tool-capable model explicitly; no model is downloaded.
BISHOP_MODEL=
BISHOP_MODEL_API_KEY=
# Create a separate Bishop bot; do not reuse a running Hermes bot token.
BISHOP_TELEGRAM_TOKEN=
BISHOP_AUDIT_TOKEN=

# Named provider profiles can reference these environment variables.
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
